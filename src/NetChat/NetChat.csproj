<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NetChat</AssemblyName>
    <RootNamespace>NetChat</RootNamespace>
    <Product>NetChat 26</Product>
    <AssemblyTitle>NetChat 26</AssemblyTitle>
    <Description>Yerel ağ mesajlaşma uygulaması</Description>
    <Version>1.1.5</Version>
    <FileVersion>1.1.5.0</FileVersion>
    <InformationalVersion>1.1.5</InformationalVersion>
    <!-- Ürün sürümüne git commit numarası eklenmesin (Ayrıntılar sekmesinde ve güncelleme denetiminde düz sürüm). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Gökdeniz G.</Company>
    <Authors>Gökdeniz G.</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF için DPI ayarı manifestte kalmalı; WinForms yalnızca tepsi simgesi için kullanılıyor. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Assets\netchat.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\netchat.ico" />
    <Resource Include="Assets\netchat.png" />
    <Resource Include="Assets\profile.ico" />
  </ItemGroup>

</Project>
