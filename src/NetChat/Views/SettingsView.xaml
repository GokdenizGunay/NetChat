<UserControl x:Class="NetChat.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:NetChat.Controls">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,36" MaxWidth="860">
            <TextBlock Text="Ayarlar" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- Yeni sürüm varken güncelleme kartı buraya, en üste taşınır -->
            <StackPanel x:Name="UpdateTopHost" Visibility="Collapsed">
                <TextBlock Text="Güncelleme" Style="{StaticResource SectionHeader}" Margin="2,24,0,8" />
            </StackPanel>

            <!-- Profil -->
            <TextBlock Text="Profil" Style="{StaticResource SectionHeader}" Margin="2,24,0,8" />
            <Border x:Name="ProfileCard" Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:Avatar x:Name="ProfileAvatar" Size="64" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Kullanıcı adı" Style="{StaticResource RowTitle}" />
                        <Grid Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NameBox" MaxLength="32" MinWidth="240" TextChanged="OnNameChanged" KeyDown="OnNameKeyDown" />
                            <ui:Button x:Name="SaveNameButton" Grid.Column="1" Margin="8,0,0,0" Content="Kaydet" Appearance="Primary"
                                       IsEnabled="False" Click="OnSaveNameClicked" />
                        </Grid>
                        <TextBlock x:Name="NameError" Margin="2,6,0,0" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock Style="{StaticResource RowDesc}" Margin="0,8,0,0"
                                   Text="Adınız ağdaki diğer kullanıcılara anında güncellenir." />
                    </StackPanel>
                </Grid>
            </Border>

            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon FolderPerson20}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Profil konumu" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="ProfilePathText" Style="{StaticResource RowDesc}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="MoveHomeButton" Content="Bu bilgisayara taşı" Margin="0,0,6,0" Click="OnMoveHomeClicked" />
                    <ui:Button Content="Profili taşı" Icon="{ui:SymbolIcon FolderArrowRight20}" Click="OnMoveProfileClicked" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardExpander Margin="0,4,0,0" Icon="{ui:SymbolIcon ShieldLock24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Güvenlik kodunuz" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowDesc}" Text="Kişilerinizin cihazında gördükleri kodla karşılaştırarak kimliğinizi doğrulayabilirler." />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <c:SecurityCodeView x:Name="MyCode" CodeFontSize="15" HorizontalAlignment="Left" />
                    <TextBlock x:Name="MyId" Style="{StaticResource RowDesc}" Margin="0,10,0,0" />
                </StackPanel>
            </ui:CardExpander>

            <!-- Görünüm -->
            <TextBlock Text="Görünüm" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Tema" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Uygulamanın açık veya koyu görünümünü seçin" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeBox" MinWidth="160" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Sistem ayarı" Tag="System" />
                    <ComboBoxItem Content="Açık" Tag="Light" />
                    <ComboBoxItem Content="Koyu" Tag="Dark" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon SlideTransition24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Animasyonlar" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Geçişler, belirme ve kaybolma efektleri" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding AnimationsEnabled}" />
            </ui:CardControl>

            <!-- Bildirimler -->
            <TextBlock Text="Bildirimler" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Icon="{ui:SymbolIcon Alert24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Yeni mesaj bildirimleri" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Uygulama arka plandayken veya kapalıyken Windows bildirimi göster" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding NotificationsEnabled}" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon DocumentText24}" IsEnabled="{Binding NotificationsEnabled}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Mesaj önizlemesi" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Bildirimde mesaj içeriğini göster" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShowMessagePreview}" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Speaker224}" IsEnabled="{Binding NotificationsEnabled}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Bildirim sesi" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Yeni mesaj geldiğinde ses çal" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding NotificationSound}" />
            </ui:CardControl>

            <!-- Gizlilik -->
            <TextBlock Text="Gizlilik" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Icon="{ui:SymbolIcon PersonAvailable24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Çevrimiçi durumu" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowDesc}"
                                   Text="Çevrimiçi, boşta veya çevrimdışı olduğunuzu göster. Karşılıklıdır: kapatırsanız siz de başkalarınınkini göremezsiniz." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShareOnlineStatus}" AutomationProperties.Name="Çevrimiçi durumu" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Clock24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Son aktiflik" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowDesc}"
                                   Text="Uygulamayı en son ne zaman kullandığınızı göster. Karşılıklıdır." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShareLastActive}" AutomationProperties.Name="Son aktiflik" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon CheckmarkCircle24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Okundu bilgisi" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowDesc}"
                                   Text="Karşılıklıdır: kapatırsanız siz de başkalarının okundu bilgisini göremezsiniz. Gruplarda her zaman gönderilir." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SendReadReceipts}" AutomationProperties.Name="Okundu bilgisi" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon History24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Mesaj geçmişini sakla" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowDesc}" TextWrapping="Wrap"
                                   Text="Kapalıyken okunan mesajlar oturum kapanınca silinir; yalnızca okunmamış ve henüz iletilemeyen mesajlar saklanır" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="HistoryToggle" AutomationProperties.Name="Mesaj geçmişini sakla" Click="OnHistoryToggleClicked" />
            </ui:CardControl>
            <ui:CardExpander x:Name="GroupAddCard" Icon="{ui:SymbolIcon People24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Gruplar" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="GroupAddSummary" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="Beni gruplara kimler ekleyebilir?" Style="{StaticResource RowTitle}" Margin="0,0,0,6" />
                    <RadioButton x:Name="GroupAddEveryone" GroupName="GroupAdd" Content="Herkes" Margin="0,4"
                                 Tag="Everyone" Checked="OnGroupAddModeChecked" />
                    <DockPanel Margin="0,4">
                        <ui:Button x:Name="GroupAddExceptButton" DockPanel.Dock="Right" Padding="10,4" Visibility="Collapsed"
                                   Click="OnGroupAddExceptClicked" />
                        <RadioButton x:Name="GroupAddExcept" GroupName="GroupAdd" Content="Şu kişiler hariç herkes"
                                     Tag="Except" Checked="OnGroupAddModeChecked" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <ui:Button x:Name="GroupAddOnlyButton" DockPanel.Dock="Right" Padding="10,4" Visibility="Collapsed"
                                   Click="OnGroupAddOnlyClicked" />
                        <RadioButton x:Name="GroupAddOnly" GroupName="GroupAdd" Content="Yalnızca şu kişiler"
                                     Tag="Only" Checked="OnGroupAddModeChecked" VerticalAlignment="Center" />
                    </DockPanel>
                    <RadioButton x:Name="GroupAddNobody" GroupName="GroupAdd" Content="Hiç kimse" Margin="0,4"
                                 Tag="Nobody" Checked="OnGroupAddModeChecked" />
                    <TextBlock Style="{StaticResource RowDesc}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="İzin vermediğiniz kişiler grup kurarken sizi seçemez. Engellediğiniz kişiler sizi hiçbir gruba ekleyemez." />
                </StackPanel>
            </ui:CardExpander>

            <!-- Sistem -->
            <TextBlock Text="Sistem" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Icon="{ui:SymbolIcon WindowArrowUp20}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Kapatınca arka planda çalış" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Pencere kapatıldığında NetChat bildirim alanında çalışmaya ve mesaj almaya devam eder" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding RunInBackground}" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Windows ile başlat" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Oturum açıldığında NetChat'i arka planda otomatik başlat" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
            </ui:CardControl>

            <!-- Dosyalar -->
            <TextBlock Text="Dosyalar" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Icon="{ui:SymbolIcon ArrowDownload20}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="İndirme klasörü" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{Binding EffectiveDownloadFolder}" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Aç" Margin="0,0,6,0" Click="OnOpenFolderClicked" />
                    <ui:Button Content="Değiştir" Click="OnChangeFolderClicked" />
                </StackPanel>
            </ui:CardControl>

            <!-- Ağ -->
            <TextBlock Text="Ağ ve güvenlik" Style="{StaticResource SectionHeader}" />
            <ui:CardControl>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon x:Name="NetIcon" Symbol="Globe24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="NetTitle" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="NetDesc" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Ağı yeniden tara" Icon="{ui:SymbolIcon ArrowSync20}" Click="OnRescanClicked" />
            </ui:CardControl>
            <ui:CardExpander Icon="{ui:SymbolIcon LockClosed24}" Margin="0,0,0,4">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Şifreleme" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Mesajlaşmalarınız şifrelidir" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Kimlik:</Run>
                    Her cihazın kalıcı bir ECDSA P-256 anahtar çifti vardır; kullanıcı kimliği açık anahtarın SHA-256 özetinden türetilir.
                    <LineBreak />
                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Bağlantı:</Run>
                    Her TCP bağlantısında geçici ECDH P-256 anahtar değişimi yapılır ve el sıkışma iki tarafın kimlik anahtarıyla imzalanır (ileri gizlilik).
                    <LineBreak />
                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Mesajlar:</Run>
                    HKDF-SHA256 ile türetilen yön başına ayrı anahtarlarla AES-256-GCM; sıra numaralı nonce'lar tekrar oynatmayı engeller. Dosyalar ayrıca SHA-256 ile doğrulanır.
                    <LineBreak />
                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Cihazda:</Run>
                    Sohbet geçmişi ve özel anahtar Windows DPAPI ile kullanıcı hesabınıza bağlı olarak şifrelenir.
                </TextBlock>
            </ui:CardExpander>

            <!-- Hakkında -->
            <TextBlock Text="Hakkında" Style="{StaticResource SectionHeader}" />
            <ui:CardControl>
                <ui:CardControl.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Assets/netchat.png" Width="24" Height="24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="NetChat 26" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="AboutText" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Uygulamadan çık" Click="OnExitClicked" />
            </ui:CardControl>
            <StackPanel x:Name="UpdateBottomHost">
                <ui:CardControl x:Name="UpdateCard" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,4,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Güncellemeleri denetle" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowDesc}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button x:Name="CheckUpdateButton" Content="Şimdi denetle" Click="OnCheckUpdatesClicked" />
                </ui:CardControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
