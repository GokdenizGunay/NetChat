<UserControl x:Class="NetChat.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:NetChat.Controls"
             xmlns:v="clr-namespace:NetChat.Views"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf">
    <UserControl.Resources>
        <!-- Sohbet listesi öğesi -->
        <DataTemplate x:Key="ConversationTemplate">
            <Grid Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:Avatar Size="44" Text="{Binding Initials}" Key="{Binding ColorKey}" IsGroup="{Binding IsGroup}"
                          ShowPresence="True" IsOnline="{Binding Peer.ShowOnlineDot, FallbackValue=False}" IsIdle="{Binding Peer.ShowIdleDot, FallbackValue=False}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Grid Margin="0,3,0,0">
                        <TextBlock Text="{Binding TypingText}" FontSize="12.5" FontStyle="Italic"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="{Binding TypingText, Converter={StaticResource NullToVis}}" />
                        <DockPanel Visibility="{Binding TypingText, Converter={StaticResource InvNullToVis}}">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding PreviewPrefix}" FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <emoji:TextBlock Text="{Binding PreviewText}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="Time" Text="{Binding LastActivity, Converter={StaticResource TimeText}}" FontSize="11.5"
                               HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <StackPanel Margin="0,4,0,0" HorizontalAlignment="Right" Height="20" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AlertOff20" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="Sessize alındı"
                                       Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                        <ui:SymbolIcon Symbol="Pin20" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                        <Border x:Name="UnreadBadge" Style="{StaticResource Badge}" Visibility="{Binding UnreadCount, Converter={StaticResource ZeroToVis}}">
                            <TextBlock Text="{Binding UnreadCount, Converter={StaticResource CountText}}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding UnreadCount, Converter={StaticResource ZeroToVis}}" Value="Visible">
                    <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <!-- Sessize alınmış sohbette okunmamış rozeti gri -->
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="UnreadBadge" Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Kişi listesi öğesi -->
        <DataTemplate x:Key="PeerTemplate">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:Avatar Size="40" Text="{Binding Initials}" Key="{Binding Id}" ShowPresence="True" IsOnline="{Binding ShowOnlineDot}" IsIdle="{Binding ShowIdleDot}"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Text="{Binding PresenceText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="AddressText" Grid.Column="2" Text="{Binding Address}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <!-- Panel daraltıldığında IP adresini gizle; adlara yer kalsın -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="narrow">
                    <Setter TargetName="AddressText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Sol ray düğmeleri -->
        <Style x:Key="RailButton" TargetType="RadioButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition x:Name="ListColumn" Width="330" MinWidth="180" MaxWidth="400" />
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol ray -->
        <DockPanel Grid.Column="0" Margin="0,4,0,12">
            <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                <!-- Kilitle (Ctrl+L): oturumu kapatır ve giriş ekranına döner -->
                <Button x:Name="LockButton" Width="44" Height="40" Margin="0,2" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Click="OnLockClicked" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        ToolTip="Kilitle (Ctrl+L)" AutomationProperties.Name="Kilitle">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" />
                </Button>
                <!-- Tüm bildirimleri sessize al / aç -->
                <Button x:Name="BellButton" Width="44" Height="40" Margin="0,2" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Click="OnBellClicked" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon x:Name="BellIcon" Symbol="Alert24" FontSize="20" />
                </Button>
                <RadioButton x:Name="SettingsTab" Style="{StaticResource RailButton}" GroupName="Rail" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar"
                             Checked="OnRailChanged">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="20" />
                </RadioButton>
                <Button x:Name="ProfileButton" Width="44" Height="44" Margin="0,6,0,0" Padding="0" HorizontalAlignment="Center"
                        Cursor="Hand" Click="OnProfileClicked" ToolTip="Profil" AutomationProperties.Name="Profil" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <c:Avatar x:Name="MyAvatar" Size="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <RadioButton x:Name="ChatsTab" Style="{StaticResource RailButton}" GroupName="Rail" IsChecked="True" ToolTip="Sohbetler" AutomationProperties.Name="Sohbetler"
                             Checked="OnRailChanged">
                    <Grid>
                        <ui:SymbolIcon Symbol="Chat24" FontSize="20" />
                        <Border x:Name="RailBadge" Width="9" Height="9" CornerRadius="4.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-1,-3,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="PeopleTab" Style="{StaticResource RailButton}" GroupName="Rail" ToolTip="Ağdaki kişiler" AutomationProperties.Name="Ağdaki kişiler"
                             Checked="OnRailChanged">
                    <Grid>
                        <ui:SymbolIcon Symbol="People24" FontSize="20" />
                        <!-- Çevrimiçi kişi sayısı -->
                        <Border x:Name="PeopleBadge" MinWidth="12" Height="12" CornerRadius="6" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-7,0" Visibility="Collapsed"
                                Background="{DynamicResource SystemFillColorSuccessBrush}" IsHitTestVisible="False">
                            <TextBlock x:Name="PeopleBadgeText" FontSize="8.5" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- Liste paneli -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorAltBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,14,12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ListTitle" Text="Sohbetler" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,6,0"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="RescanButton" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}" Padding="8"
                                       ToolTip="Ağı yeniden tara" AutomationProperties.Name="Ağı yeniden tara" Click="OnRescanClicked" Visibility="Collapsed" />
                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon PeopleAdd24}" Padding="8" ToolTip="Yeni grup" AutomationProperties.Name="Yeni grup"
                                       Click="OnNewGroupClicked" />
                        </StackPanel>
                    </Grid>
                    <ui:TextBox x:Name="SearchBox" Margin="0,12,0,0" PlaceholderText="Ara" Icon="{ui:SymbolIcon Search24}"
                                ClearButtonEnabled="True" TextChanged="OnSearchChanged" />
                </StackPanel>

                <!-- Ağ durumu altbilgisi -->
                <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Grid Width="16" Height="16" DockPanel.Dock="Left">
                            <ui:SymbolIcon x:Name="NetWifi" Symbol="Wifi124" FontSize="15" Visibility="Collapsed" />
                            <ui:FontIcon x:Name="NetWired" Glyph="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="14" Visibility="Collapsed" />
                            <ui:SymbolIcon x:Name="NetOffline" Symbol="GlobeProhibited24" FontSize="15" Visibility="Collapsed"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Grid>
                        <TextBlock x:Name="NetText" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </DockPanel>
                </Border>

                <Grid>
                    <ListBox x:Name="ConversationList" IsSynchronizedWithCurrentItem="False" Style="{StaticResource BareListBox}" ItemContainerStyle="{StaticResource NavListItem}"
                             ItemTemplate="{StaticResource ConversationTemplate}" SelectionChanged="OnConversationSelected"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Padding="0,4,0,8">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="OnConversationMenuOpened">
                                <MenuItem x:Name="PinItem" Header="Sabitle" Click="OnPinClicked">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Pin20" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="UnreadItem" Header="Okunmadı olarak işaretle" Click="OnMarkUnreadClicked">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="MailUnread20" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MuteItem" Header="Sessize al" Click="OnMuteClicked">
                                    <MenuItem.Icon><ui:SymbolIcon x:Name="MuteItemIcon" Symbol="AlertOff20" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="BlockItem" Header="Engelle" Click="OnBlockClicked">
                                    <MenuItem.Icon><ui:SymbolIcon x:Name="BlockItemIcon" Symbol="PersonProhibited20" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sohbeti temizle" Click="OnClearClicked">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="DeleteLines20" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="DeleteItem" Header="Sohbeti sil" Click="OnDeleteClicked">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Delete20" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <ListBox x:Name="PeopleList" IsSynchronizedWithCurrentItem="False" Style="{StaticResource BareListBox}" ItemContainerStyle="{StaticResource NavListItem}"
                             ItemTemplate="{StaticResource PeerTemplate}" Visibility="Collapsed" Padding="0,4,0,8"
                             SelectionChanged="OnPeerSelected" />

                    <!-- Boş durumlar -->
                    <StackPanel x:Name="EmptyChats" VerticalAlignment="Center" Margin="28,0,28,60" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Henüz sohbet yok" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Ağdaki kişiler sekmesinden birini seçerek sohbete başlayın veya yeni bir grup oluşturun." />
                        <ui:Button Content="Ağdaki kişileri göster" HorizontalAlignment="Center" Margin="0,14,0,0" Click="OnShowPeopleClicked" />
                    </StackPanel>
                    <StackPanel x:Name="EmptyPeople" VerticalAlignment="Center" Margin="28,0,28,60" Visibility="Collapsed">
                        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center" />
                        <TextBlock Text="Ağ taranıyor…" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Aynı yerel ağda NetChat çalıştıran cihazlar otomatik olarak burada görünür." />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Liste panelini yeniden boyutlandırma tutamacı (panel kenarı) -->
        <GridSplitter x:Name="ListSplitter" Grid.Column="1" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      ResizeBehavior="CurrentAndNext" ResizeDirection="Columns" Background="Transparent" Panel.ZIndex="1"
                      Cursor="SizeWE" FocusVisualStyle="{x:Null}" KeyboardIncrement="20" DragIncrement="1"
                      AutomationProperties.Name="Liste genişliği" DragCompleted="OnSplitterDragCompleted" />

        <!-- İçerik alanı -->
        <Border Grid.Column="2" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid x:Name="ContentHost">
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Image Source="pack://application:,,,/Assets/netchat.png" Width="84" Height="84" Opacity="0.95" />
                    <TextBlock Text="NetChat 26" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Mesajlaşmaya başlamak için bir sohbet seçin." FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <ui:SymbolIcon Symbol="LockClosed20" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Mesajlaşmalarınız şifrelidir." Margin="6,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <v:ChatView x:Name="Chat" Visibility="Collapsed" />
                <v:SettingsView x:Name="Settings" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Uygulama içi bilgi çubuğu -->
        <ui:InfoBar x:Name="InfoBar" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,90" MaxWidth="520" IsClosable="True" Severity="Warning" Visibility="Collapsed" />

        <c:DialogHost x:Name="Dialogs" Grid.ColumnSpan="3" />
    </Grid>
</UserControl>
